<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- So `dotnet user-secrets` works for the Entra client secret. See scripts/tenant-setup.md. -->
    <UserSecretsId>acp-databook-portal</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Acp.Portal.Domain/Acp.Portal.Domain.csproj" />
    <ProjectReference Include="../Acp.Portal.Infrastructure/Acp.Portal.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Identity.Web" />
  </ItemGroup>

  <!-- The test project drives the app through WebApplicationFactory. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Acp.Portal.Tests" />
  </ItemGroup>

</Project>
