{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Portal": ""
  },
  "Auth": {
    "//": "Entra by default so that an environment which forgets to configure anything fails closed.",
    "Mode": "Entra",
    "SessionLifetimeMinutes": 480,
    "StaffEmailDomains": [],
    "HomeTenantId": "",
    "InviteRedirectUrl": ""
  },
  "Entra": {
    "//": "Filled in from scripts/tenant-setup.md. Locally via config/entra.local.json; in Azure via app settings.",
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/api/auth/callback",
    "SignedOutCallbackPath": "/api/auth/signed-out"
  }
}
