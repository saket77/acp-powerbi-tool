{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Portal": ""
  },
  "Auth": {
    "//": "Entra by default so that an environment which forgets to configure anything fails closed.",
    "Mode": "Entra",
    "SessionLifetimeMinutes": 480,
    "StaffEmailDomains": [],
    "HomeTenantId": "",
    "InviteRedirectUrl": ""
  },
  "Storage": {
    "//": "Azure addresses the account by URL and reaches it with the managed identity; there is no key, because the account has shared-key access switched off.",
    "BlobAccountUrl": "",
    "QueueAccountUrl": "",
    "UploadsContainer": "pbix-uploads",
    "ImportQueue": "pbix-imports",
    "SasLifetimeMinutes": 20,
    "VisibilityTimeoutSeconds": 900,
    "MaxAttempts": 3,
    "MaxUploadMegabytes": 512
  },
  "PowerBi": {
    "//": "Live by default so that an environment which forgets to configure anything fails closed.",
    "Mode": "Live",
    "ApiBaseUrl": "https://api.powerbi.com/v1.0/myorg/",
    "CapacityId": "",
    "EmbedTokenLifetimeMinutes": 30,
    "ClientRole": "Client",
    "AcpRole": "ACP",
    "IdentityMode": "Username",
    "CodeSeparator": "|"
  },
  "Entra": {
    "//": "Filled in from scripts/tenant-setup.md. Locally via config/entra.local.json; in Azure via app settings.",
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/api/auth/callback",
    "SignedOutCallbackPath": "/api/auth/signed-out"
  }
}
