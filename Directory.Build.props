<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      Not InvariantGlobalization: Microsoft.Data.SqlClient refuses to run in invariant mode
      ("Globalization Invariant Mode is not supported"), and it is what EF Core's SQL Server
      provider uses. The app needs ICU anyway — client companies have umlauts in their names,
      and sorting them per the invariant culture would look broken to a German reader.
    -->
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Audit the packages we actually choose, and fail the build on them.

    Not "all": the transitive graph drags in System.Security.Cryptography.Xml and .Pkcs 10.0.0
    through Microsoft.EntityFrameworkCore.Design -> Microsoft.Build.Tasks.Core, both carry open
    advisories, and the only newer builds on nuget.org are 11.0.0 previews. Design is a
    design-time package (PrivateAssets=all) used by `dotnet ef`; it is never part of what
    deploys. Blocking every build on a tooling advisory with no stable fix trains people to
    ignore the audit, which is worse than the advisory.

    Revisit when System.Security.Cryptography.* 11.0.0 ships stable: switch this back to `all`
    and see what is left. For the full picture at any time, run `dotnet list package` with the
    vulnerable and include-transitive flags.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

</Project>
